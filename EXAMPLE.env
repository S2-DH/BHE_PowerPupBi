# ===================================================================
# BHE API credentials for the Power BI extract
# ===================================================================
# Copy this file to ".env" (same folder as the script) and fill in
# your real values. Do NOT commit the real .env to git.
#
# BHE_API_URL  - your tenant host. Scheme optional (https:// is added
#                automatically). No trailing slash needed.
# BHE_TOKEN_ID - the API token ID from the BHE console.
# BHE_TOKEN_KEY- the API token KEY (the secret). Treat like a password.
# ===================================================================

BHE_API_URL=http://localhost:8080
BHE_TOKEN_ID=79bfed17-10a3-111-9c50-cc98b74a829c
BHE_TOKEN_KEY=3v4t+xbE4hJu5YSj1111c0GKCW/JYEHKSZJsTg/t7pOqL8L6iXYIzg==
